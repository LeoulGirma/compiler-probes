<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- variants are chosen on the command line: -p:TargetFramework=net10.0|net11.0  -p:PublishAot=true  -p:Features=runtime-async=on -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>paysvc</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
</Project>
